// File name: projects/1/Or8Way.hdl
/**
 * 8-way Or gate: 
 * out = in[0] Or in[1] Or ... Or in[7]
 */
CHIP Or8Way {
    IN in[8];
    OUT out;

    PARTS:
    //// Replace this comment with your code.
    Or(a=in[0] , b=in[1] , out= out2bits);
    Or(a=in[2], b=in[3] , out=out4bits);
    Or(a=in[4] , b=in[5] , out= out6bits);
    Or(a=in[6], b=in[7] , out=out8bits );
    Or(a=out2bits , b=out4bits , out=outtotal6bits );
    Or(a=outtotal6bits , b=out6bits , out=outotal12bits );
    Or(a=outotal12bits , b=out8bits , out=out );
}