// File name: projects/1/Mux.hdl
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    //// Replace this comment with your code.
    Or(a=a , b=sel , out=Axorout );
    Not(in=sel , out= notsel);
    Or(a= notsel, b = b , out = Bxorout);
    And(a= Axorout, b= Bxorout, out= out );

    

    

    
}